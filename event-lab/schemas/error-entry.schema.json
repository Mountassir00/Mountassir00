{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://event-lab.local/schemas/error-entry.schema.json",
  "title": "ErrorEntry",
  "description": "Entrée du registre des erreurs événementielles à ne pas reproduire. Les causes sont 'probables' sauf si un rapport officiel les établit.",
  "type": "object",
  "required": ["id", "title", "domain", "severity", "description", "probable_causes", "consequences", "warning_signs", "preventive_measures", "corrective_plan", "sources", "cause_status"],
  "properties": {
    "id": { "type": "string", "description": "Format : E-NNN" },
    "title": { "type": "string" },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": { "name": { "type": "string" }, "date": { "type": "string" }, "city": { "type": "string" }, "country": { "type": "string" } }
      }
    },
    "domain": { "enum": ["inscriptions", "billetterie", "files_attente", "accueil", "ambiance", "sequencage", "temps_morts", "regles", "visibilite", "animations", "restauration", "accessibilite", "securite", "benevoles", "experience_athletes", "satisfaction", "communication", "sponsors", "rentabilite", "medias", "environnement", "gouvernance"] },
    "severity": { "enum": ["mineure", "majeure", "critique"] },
    "applies_to_scale": { "type": "array", "items": { "enum": ["local", "regional", "national", "international"] } },
    "description": { "type": "string" },
    "probable_causes": { "type": "array", "items": { "type": "string" } },
    "cause_status": { "enum": ["etablie_rapport_officiel", "recoupee_presse", "probable"], "description": "Niveau de preuve des causes." },
    "consequences": { "type": "array", "items": { "type": "string" } },
    "warning_signs": { "type": "array", "items": { "type": "string" } },
    "preventive_measures": { "type": "array", "items": { "type": "string" } },
    "corrective_plan": { "type": "array", "items": { "type": "string" }, "description": "Actions à déclencher si l'erreur survient pendant l'événement." },
    "checklist_items": { "type": "array", "items": { "type": "string" }, "description": "Points de contrôle injectés dans les checklists des blueprints." },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["url", "title"],
        "properties": { "url": { "type": "string" }, "title": { "type": "string" }, "publisher": { "type": "string" }, "reliability": { "enum": ["A", "B", "C", "D"] } }
      }
    }
  }
}
